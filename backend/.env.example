# OpenAI-compatible LLM configuration. Keep the real key only in .env.
LLM_BASE_URL=https://zhenze-huhehaote.cmecloud.cn/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash-0731
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1600
LLM_TEMPERATURE=0.7
# Set false to use only the deterministic rule parser for profile extraction.
PROFILE_EXTRACTION_ENABLED=true
PROFILE_EXTRACTION_TIMEOUT_SECONDS=5
FINAL_EXPLANATION_TIMEOUT_SECONDS=12

# Agent autonomous reply engine: LLM decides whether to call read-only tools
# (policy search / detail / eligibility / materials / realtime) before replying.
AGENT_REPLY_ENABLED=true
AGENT_REPLY_MAX_TOOL_ROUNDS=3
AGENT_REPLY_TIMEOUT_SECONDS=15

# Comma-separated frontend origins allowed during development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Phase 1 stores conversation history in backend memory.
SESSION_HISTORY_LIMIT=20
SESSION_LIMIT=1000

# Tavily real search is disabled by default. Keep the real key only in .env.
REALTIME_POLICY_SEARCH_ENABLED=false
REALTIME_POLICY_SEARCH_PROVIDER=tavily
REALTIME_POLICY_SEARCH_API_KEY=
REALTIME_POLICY_ALLOWED_DOMAINS=suzhou.gov.cn,hrss.suzhou.gov.cn
REALTIME_POLICY_SEARCH_TIMEOUT_SECONDS=8
REALTIME_POLICY_SEARCH_MAX_RESULTS=5

# User-toggleable full-web search (DeepSeek-style switch in the chat composer).
WEB_SEARCH_ENABLED=false
WEB_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_MAX_RESULTS=5

# Dify Knowledge is disabled by default. Keep the real dataset key only in .env.
DIFY_KNOWLEDGE_ENABLED=false
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_DATASET_ID=
DIFY_DATASET_API_KEY=
DIFY_KNOWLEDGE_TIMEOUT_SECONDS=5
DIFY_KNOWLEDGE_TOP_K=5
